<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Yggdrasilnet.Server</AssemblyName>
        <RootNamespace>Yggdrasilnet.Server</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="LiteNetLib" Version="2.1.4" />
        <PackageReference Include="Serilog" Version="4.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
        <PackageReference Include="Serilog.Sinks.Spectre" Version="0.5.0" />
        <PackageReference Include="Spectre.Console" Version="0.49.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Yggdrasilnet.Maths\Yggdrasilnet.Maths.csproj" />
        <ProjectReference Include="..\Yggdrasilnet.Network\Yggdrasilnet.Network.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Update="server.config.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="BehaviorPack\**\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="src\Event\Events\" />
    </ItemGroup>

</Project>
