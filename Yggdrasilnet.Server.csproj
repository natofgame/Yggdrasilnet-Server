<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Yggdrasilnet.Server</AssemblyName>
        <RootNamespace>Yggdrasilnet.Server</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="LiteNetLib" Version="2.1.4"/>
        <PackageReference Include="Serilog" Version="4.0.0"/>
        <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Yggdrasilnet.Maths\Yggdrasilnet.Maths.csproj"/>
        <ProjectReference Include="..\Yggdrasilnet.NetworkV4\Yggdrasilnet.NetworkV4.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="src\World\Component\"/>
        <Folder Include="src\World\Content\Spell\Behaviors\"/>
        <Folder Include="src\World\Event\Events\"/>
        <Folder Include="src\World\Runtime\"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="BehaviorPack\**\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
